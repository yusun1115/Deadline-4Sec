    successText: 4.00 RESET!
  - stepId: near_miss
    kind: 1
    title: NEAR MISS
    dialogueText: "\uC7A5\uC560\uBB3C\uC5D0 \uBD80\uB52A\uD788\uAE30 \uC9C1\uC804\uAE4C\uC9C0
      \uAE30\uB2E4\uB838\uB2E4\uAC00 \uC67C\uCABD\uC73C\uB85C \uC2A4\uC640\uC774\uD504!
      \uC544\uC2AC\uC544\uC2AC\uD558\uAC8C \uD53C\uD574\uC57C \uB2C8\uC5B4 \uBBF8\uC2A4\uC57C."
