    failText: "\uC557, \uC544\uC26C\uC6CC! \uC774\uBC88 \uB2E8\uACC4\uB97C \uB2E4\uC2DC
      \uD574 \uBCF4\uC790."
    completeText: "\uC644\uBCBD\uD574! \uC801 \uCC98\uCE58\uC640 \uB2C8\uC5B4 \uBBF8\uC2A4\uB85C
      4\uCD08\uB97C \uACC4\uC18D \uB418\uB3CC\uB824. \uC774\uC81C \uC2E4\uC804\uC774\uC57C!"
    completeHold: 1.8
    endFadeOut: 0.6
    endFadeIn: 0.5
