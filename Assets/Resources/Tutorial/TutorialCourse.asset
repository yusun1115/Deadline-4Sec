    highlightTarget: 1
    dimBackground: 1
    requiredInputType: 0
    showSwipeGuide: 0
    autoAdvance: 1
    nextDelay: 3.5
    completeCondition: 0
    pauseForInput: 0
    successText: 
  - stepId: lane_move
    kind: 1
    title: LANE MOVE
    dialogueText: "\uC88B\uC544, \uC774\uC81C \uC9C1\uC811 \uC6C0\uC9C1\uC5EC \uBCF4\uC790.
      \uBA3C\uC800 \uC67C\uCABD\uC73C\uB85C \uC2A4\uC640\uC774\uD504\uD574!"
    followUpText: "\uC798\uD588\uC5B4! \uC774\uBC88\uC5D4 \uC624\uB978\uCABD\uC73C\uB85C
      \uC2A4\uC640\uC774\uD504\uD574\uC11C \uAC00\uC6B4\uB370\uB85C \uB3CC\uC544\uC640."
    highlightTarget: 0
    dimBackground: 0
    requiredInputType: 1
    showSwipeGuide: 1
    autoAdvance: 1
    nextDelay: 0.6
    completeCondition: 1
    pauseForInput: 1
    successText: 
  - stepId: jump
    kind: 1
    title: JUMP
    dialogueText: "\uC55E\uC5D0 \uC7A5\uC560\uBB3C\uC774 \uC788\uC5B4. \uAC00\uAE4C\uC6CC\uC9C0\uBA74
      \uC704\uB85C \uC2A4\uC640\uC774\uD504\uD574\uC11C \uB6F0\uC5B4\uB118\uC5B4!"
    followUpText: 
    highlightTarget: 0
    dimBackground: 0
    requiredInputType: 3
    showSwipeGuide: 1
    autoAdvance: 1
    nextDelay: 0.6
    completeCondition: 2
    pauseForInput: 1
    successText: 
  - stepId: slide
    kind: 1
    title: SLIDE
    dialogueText: "\uC774\uBC88\uC5D4 \uB192\uC740 \uC7A5\uC560\uBB3C\uC774\uC57C.
      \uC544\uB798\uB85C \uC2A4\uC640\uC774\uD504\uD574\uC11C \uBC11\uC73C\uB85C
      \uBBF8\uB044\uB7EC\uC838!"
    followUpText: 
    highlightTarget: 0
    dimBackground: 0
    requiredInputType: 4
    showSwipeGuide: 1
    autoAdvance: 1
    nextDelay: 0.6
    completeCondition: 3
    pauseForInput: 1
    successText: 
  - stepId: lane_attack
    kind: 1
    title: LANE ATTACK
    dialogueText: "\uC606 \uB808\uC778\uC5D0 \uC801\uC774 \uC788\uC5B4. \uC801 \uCABD\uC73C\uB85C
      \uC2A4\uC640\uC774\uD504\uD558\uBA74 \uB0AB\uC73C\uB85C \uBCA0\uC5B4 \uBC84\uB824!"
    followUpText: 
