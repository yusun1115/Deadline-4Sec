    pauseForInput: 1
    successText: NEAR MISS!
  - stepId: air_homing
    kind: 1
    title: AIR HOMING
    dialogueText: "\uC704\uB85C \uD55C \uBC88 \uC2A4\uC640\uC774\uD504\uD558\uBA74
