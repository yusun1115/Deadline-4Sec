    dialogueText: "\uC810\uD504\uD55C \uB2E4\uC74C, \uACF5\uC911\uC5D0\uC11C \uC544\uB798\uB85C
      \uC2A4\uC640\uC774\uD504\uD558\uBA74 \uBE60\uB974\uAC8C \uCC29\uC9C0\uD574."
