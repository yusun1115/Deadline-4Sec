    successText: 
  - stepId: timer_rule
    kind: 0
    title: 4-SECOND RULE
    dialogueText: "0\uC774 \uB418\uBA74 \uBC14\uB85C \uAC8C\uC784\uC624\uBC84! \uC801\uC744
      \uCC98\uCE58\uD558\uAC70\uB098 \uC544\uC2AC\uC544\uC2AC\uD558\uAC8C \uD53C\uD558\uBA74
      \uB2E4\uC2DC 4\uCD08\uB85C \uB3CC\uC544\uAC00."
